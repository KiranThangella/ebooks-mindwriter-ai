{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MindWriter Ebook Metadata Schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the ebook (slug format)."
    },
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "moods": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Mood tags used for MindWriter app filtering."
    },
    "categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pages": {
      "type": "integer"
    },
    "publishedAt": {
      "type": "string",
      "format": "date"
    }
  },
  "required": ["id", "title", "author", "description", "moods"]
}
